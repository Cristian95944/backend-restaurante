### Variables
@base_url = http://localhost:8002
@token = aqui_va_el_token_despues_de_login

### Listar mesas
GET {{base_url}}/mesas
Authorization: Bearer {{token}}

###

### Ver mesa
GET {{base_url}}/mesas/1
Authorization: Bearer {{token}}

###

### Crear mesa
POST {{base_url}}/mesas
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "numero": "MESA-5",
    "capacidad": 4,
    "estado": "disponible"
}

###

### Editar mesa
PUT {{base_url}}/mesas/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "capacidad": 6,
    "estado": "disponible"
}

###

### Cambiar estado mesa
PATCH {{base_url}}/mesas/1/estado
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "estado": "ocupada"
}

###

### Listar reservas
GET {{base_url}}/reservas
Authorization: Bearer {{token}}

###

### Crear reserva
POST {{base_url}}/reservas
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre_cliente": "Carlos Ramirez",
    "telefono_cliente": "3001234567",
    "cantidad_personas": 4,
    "fecha": "2026-06-15",
    "hora": "19:00:00",
    "observaciones": "Reserva familiar",
    "mesa_id": 2
}

###

### Cancelar reserva
PATCH {{base_url}}/reservas/1/cancelar
Authorization: Bearer {{token}}
