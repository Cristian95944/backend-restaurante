### Variables
@base_url = http://localhost:8001
@token = aqui_va_el_token_despues_de_login

### Login
POST {{base_url}}/auth/login
Content-Type: application/json

{
    "usuario": "admin",
    "contrasena": "123456"
}

###

### Logout
POST {{base_url}}/auth/logout
Content-Type: application/json
Authorization: Bearer {{token}}

###

### Verificar token
GET {{base_url}}/auth/verificar
Authorization: Bearer {{token}}